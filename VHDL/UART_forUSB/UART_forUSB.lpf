BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

#=========================================================
# Clock
#=========================================================

LOCATE COMP "Clk" SITE "L19";
IOBUF PORT "Clk" IO_TYPE=LVCMOS33;

FREQUENCY PORT "Clk" 125.0 MHz;

#=========================================================
# UART
#=========================================================

LOCATE COMP "Uart_Tx" SITE "C11";
IOBUF PORT "Uart_Tx" IO_TYPE=LVCMOS33;

LOCATE COMP "Uart_Rx" SITE "A11";
IOBUF PORT "Uart_Rx" IO_TYPE=LVCMOS33;

#=========================================================
# Reset (if external)
#=========================================================

# LOCATE COMP "Rst" SITE "<RESET_PIN>";
# IOBUF PORT "Rst" IO_TYPE=LVCMOS33;