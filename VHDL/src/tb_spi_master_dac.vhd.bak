library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity spi_master_dac_tb is
end entity spi_master_dac_tb;

architecture sim of spi_master_dac_tb is

    constant CLK_PERIOD : time := 20 ns;

    signal clk        : std_logic := '0';
    signal rst        : std_logic := '1';
    signal data_in    : std_logic_vector(15 downto 0) := (others => '0');
    signal fifo_empty : std_logic_vector(0 downto 0)  := "1";
    signal read_en    : std_logic_vector(0 downto 0);
    signal sdi        : std_logic_vector(0 downto 0);
    signal cs_n       : std_logic;
    signal spi_clk    : std_logic;

    signal captured    : std_logic_vector(15 downto 0) := (others => '0');
    signal capture_cnt : integer := 0;

begin

    clk <= not clk after CLK_PERIOD / 2;

    dut : entity work.spi_master_dac
        generic map (Num_Channels => 1)
        port map (
            clk => clk, rst => rst,
            data_in => data_in, fifo_empty => fifo_empty, read_en => read_en,
            sdi => sdi, cs_n => cs_n, spi_clk => spi_clk
        );

    p_capture : process(clk)
    begin
        if rising_edge(clk) then
            if cs_n = '0' then
                captured <= captured(14 downto 0) & sdi(0);
                capture_cnt <= capture_cnt + 1;
            else
                capture_cnt <= 0;
            end if;
        end if;
    end process;

    p_stim : process
    begin
        rst <= '1';
        wait for 5 * CLK_PERIOD;
        rst <= '0';
        wait for 2 * CLK_PERIOD;

        -- Frame 1
        data_in <= x"AAAA";
        fifo_empty <= "0";
        wait until cs_n = '0';           -- wait for transfer to start
        wait until cs_n = '1';           -- wait for transfer to end
        wait until rising_edge(clk);     -- let capture register update
        assert captured = x"AAAA" report "Frame 1 fail" severity failure;

        -- Frame 2 (back-to-back)
        data_in <= x"1234";
        wait until cs_n = '0';
        wait until cs_n = '1';
        wait until rising_edge(clk);
        assert captured = x"1234" report "Frame 2 fail" severity failure;

        -- Frame 3 (back-to-back)
        data_in <= x"8001";
        wait until cs_n = '0';
        wait until cs_n = '1';
        wait until rising_edge(clk);
        assert captured = x"8001" report "Frame 3 fail" severity failure;

        -- Stall
        fifo_empty <= "1";
        wait for 10 * CLK_PERIOD;

        -- Frame 4 (after stall)
        data_in <= x"DEAD";
        fifo_empty <= "0";
        wait until cs_n = '0';
        wait until cs_n = '1';
        wait until rising_edge(clk);
        assert captured = x"DEAD" report "Frame 4 fail" severity failure;

        fifo_empty <= "1";
        wait for 5 * CLK_PERIOD;

        report "ALL PASS" severity note;
        wait;
    end process;

end architecture sim;