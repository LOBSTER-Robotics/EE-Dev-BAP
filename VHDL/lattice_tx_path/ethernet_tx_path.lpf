BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

###############################################################################
# CLOCK INPUT
###############################################################################

# NOTE:
# You MUST adjust this depending on your actual clock source:
# - PHY 125 MHz clock OR onboard oscillator

LOCATE COMP "clk" SITE "L19";
IOBUF PORT "clk" IO_TYPE=LVCMOS25;

FREQUENCY PORT "clk" 125.0 MHz;

###############################################################################
# RESET (map to a switch or button)
###############################################################################

# Example: SW0 used as reset
LOCATE COMP "rst" SITE "H2";
IOBUF PORT "rst" IO_TYPE=LVCMOS15;

###############################################################################
# RGMII OUTPUTS (Ethernet PHY Port 0 / PHY1)
###############################################################################

# TX clock (generated by FPGA in RGMII)
LOCATE COMP "rgmii_txc" SITE "P19";

# TX data
LOCATE COMP "rgmii_txd[0]" SITE "N19";
LOCATE COMP "rgmii_txd[1]" SITE "N20";
LOCATE COMP "rgmii_txd[2]" SITE "P18";
LOCATE COMP "rgmii_txd[3]" SITE "P20";

# TX control (TX_EN)
LOCATE COMP "rgmii_txctl" SITE "R20";

###############################################################################
# IO standards for RGMII (VERY IMPORTANT)
###############################################################################

# RGMII on Versa PHY is typically 1.8V signaling
IOBUF PORT "rgmii_txd[0]" IO_TYPE=LVCMOS25;
IOBUF PORT "rgmii_txd[1]" IO_TYPE=LVCMOS25;
IOBUF PORT "rgmii_txd[2]" IO_TYPE=LVCMOS25;
IOBUF PORT "rgmii_txd[3]" IO_TYPE=LVCMOS25;
IOBUF PORT "rgmii_txctl"   IO_TYPE=LVCMOS25;
IOBUF PORT "rgmii_txc"     IO_TYPE=LVCMOS25;